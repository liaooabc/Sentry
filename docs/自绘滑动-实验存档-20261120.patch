+/// 滚轮手势的主轴判断。
+///
+/// `swipeActions` 的横滑走的也是 `scrollWheel` 事件，和列表滚动同一个通道；
+/// 但横滑那一刻是「这一行在跟手平移」，不是「列表在滚」，两者必须分开处理，
+/// 否则悬停高亮条会被当成「正在滚动」而原地冻住。
+enum ScrollGestureAxis {
+    /// dx 占优才算横滑；相等时保守地算纵向（宁可当滚动，也别误判成横滑）。
+    static func isHorizontal(deltaX: CGFloat, deltaY: CGFloat) -> Bool {
+        abs(deltaX) > abs(deltaY)
+    }
+}
