+// MARK: - 左右滑的手势
+
+/// 横向两指滑动的手势源。
+/// 系统的 swipeActions 形状是黑盒（直角通栏、改不了），所以按钮自己画，
+/// 手势也只能自己听：在窗口这一层收 scrollWheel，横向占优就当作「在滑某一行」。
+/// 只更新被滑那一行的 SwipeBox，落位交给行自己——这样拖动时只重绘一行。
+final class SwipeMonitorView: NSView {
+    var page = 0
+    var store: SwipeStore?
+    var isActive: () -> Bool = { true }
+
+    private var monitor: Any?
+    private weak var dragging: SwipeBox?
+    private var draggingKey: String?
+
+    /// 别挡住行里的点击
+    override func hitTest(_ point: NSPoint) -> NSView? { nil }
+
+    override func viewDidMoveToWindow() {
+        super.viewDidMoveToWindow()
+        if window == nil { detach() } else { attach() }
+    }
+
+    func detach() {
+        if let monitor { NSEvent.removeMonitor(monitor) }
+        monitor = nil
+    }
+
+    private func attach() {
+        guard monitor == nil else { return }
+        monitor = NSEvent.addLocalMonitorForEvents(matching: .scrollWheel) { [weak self] event in
+            guard let self else { return event }
+            return self.handle(event)
+        }
+    }
+
+    private func handle(_ event: NSEvent) -> NSEvent? {
+        guard isActive(), let window, let store else { return event }
+
+        let dx = event.scrollingDeltaX
+        let dy = event.scrollingDeltaY
+        let horizontal = abs(dx) > abs(dy) * 1.2 && abs(dx) > 0.4
+
+        // 惯性段：横向的吃掉（不然松手后按钮还会被拉开一段），竖向的照常交给列表，
+        // 否则一甩到底的滚动会突然停死
+        guard event.momentumPhase.isEmpty else { return horizontal ? nil : event }
+
+        // 竖向滚动不归这里管：顺手把已经滑开的那一行收回去
+        guard horizontal else {
+            if abs(dy) > 0.4 { closeDragging() }
+            return event
+        }
+
+        // 必须压在某一行的锚点上：行间隙、页头、底栏都不算
+        let point = window.mouseLocationOutsideOfEventStream
+        guard let anchor = RowAnchorStore.shared.hit(at: point, page: page) else {
+            closeDragging()
+            return event
+        }
+        let key = anchor.anchorKey
+        let box = store.box(for: Self.rowID(from: key))
+
+        // 这一侧没有按钮就别让行挪：挪开会露出底下的面板，看着像坏了
+        if dx > 0, !box.canLead { return nil }
+        if dx < 0, !box.canTrail { return nil }
+
+        switch event.phase {
+        case .began:
+            begin(key: key, box: box)
+            push(box, dx)
+        case .ended, .cancelled:
+            guard draggingKey == key else { return nil }
+            box.dragging = false
+            box.released += 1
+        default:
+            // 没有 phase 的是鼠标滚轮：不接管，留给列表
+            guard draggingKey == key else { return event }
+            push(box, dx)
+        }
+        return nil
+    }
+
+    private func begin(key: String, box: SwipeBox) {
+        guard draggingKey != key else { return }
+        // 换了一行：上一行如果还开着，先收回去
+        if let old = dragging, old !== box, abs(old.offset) > 0.5 {
+            withAnimation(SwipeMetrics.spring) { old.offset = 0 }
+            old.dragging = false
+        }
+        draggingKey = key
+        dragging = box
+        box.dragging = true
+    }
+
+    /// 位移跟手。超过按钮宽度后加阻力，滑不出太远
+    private func push(_ box: SwipeBox, _ dx: CGFloat) {
+        let limit = SwipeMetrics.width
+        var next = box.offset + dx
+        if next > limit { next = limit + (next - limit) * 0.25 }
+        if next < -limit { next = -limit + (next + limit) * 0.25 }
+        box.offset = next
+    }
+
+    private func closeDragging() {
+        guard let box = dragging else { return }
+        box.dragging = false
+        if abs(box.offset) > 0.5 {
+            withAnimation(SwipeMetrics.spring) { box.offset = 0 }
+        }
+        dragging = nil
+        draggingKey = nil
+    }
+
+    private static func rowID(from key: String) -> String {
+        guard let i = key.firstIndex(of: "#") else { return key }
+        return String(key[key.index(after: i)...])
+    }
+}
+
+private struct SwipeMonitor: NSViewRepresentable {
+    let store: SwipeStore
+    let page: Int
+    let active: () -> Bool
+
+    func makeNSView(context: Context) -> SwipeMonitorView {
+        let view = SwipeMonitorView()
+        view.page = page
+        view.store = store
+        view.isActive = active
+        return view
+    }
+
+    func updateNSView(_ view: SwipeMonitorView, context: Context) {
+        view.page = page
+        view.store = store
+        view.isActive = active
+    }
+
+    static func dismantleNSView(_ view: SwipeMonitorView, coordinator: ()) {
+        view.detach()
+    }
+}
